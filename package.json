{
  "name": "json-editor-desktop",
  "productName": "JSON Editor",
  "version": "1.0.0",
  "description": "Offline desktop clone of JSON Editor Online (jsoneditoronline.org) built with Electron and svelte-jsoneditor",
  "main": "main.cjs",
  "author": {
    "name": "Jamilur Rahman",
    "email": "jamilxt@users.noreply.github.com"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist:mac": "npx electron-builder --mac --config electron-builder.yml",
    "dist:linux": "npx electron-builder --linux AppImage --config electron-builder.yml",
    "dist:win": "npx electron-builder --win portable --config electron-builder.yml"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "electron": "^38.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "jmespath": "^0.16.0",
    "jq-wasm": "^1.0.0",
    "jsonrepair": "^3.12.0",
    "lodash-es": "^4.17.21",
    "svelte-jsoneditor": "^3.13.0"
  }
}
